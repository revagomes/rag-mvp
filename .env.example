# Copy this file to .env and adjust as needed. All values have sensible defaults.

# ---- Embeddings ----
# Backend: "local" (sentence-transformers, no API key) or "openai"
RAG_EMBEDDING_BACKEND=local
# Local model name (downloaded on first use)
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# OpenAI embedding model (only used when backend=openai)
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- LLM (answer generation) ----
# Backend: "none" (return chunks only), "ollama" (local), or "openai"
RAG_LLM_BACKEND=none
# Ollama settings (only used when backend=ollama)
RAG_OLLAMA_URL=http://localhost:11434
RAG_OLLAMA_MODEL=llama3.2
# OpenAI settings (only used when backend=openai)
RAG_OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- OpenAI credentials (only if any backend=openai) ----
# OPENAI_API_KEY=sk-...

# ---- Chunking ----
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# ---- Retrieval ----
RAG_TOP_K=4

# ---- Storage ----
RAG_STORAGE_DIR=./storage
RAG_COLLECTION_NAME=documents
